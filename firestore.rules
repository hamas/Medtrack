rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /users/{userId}
// Document ID: userId (matches request.auth.uid)
// Fields:
//   - uid: string (required, 1-128 chars, immutable, matches auth UID and document ID)
//   - name: string (required, 1-100 chars)
//   - currentStreak: int (optional/nullable, >= 0)
//   - longestStreak: int (optional/nullable, >= 0)
//   - earnedBadges: list of maps (optional/nullable, size <= 100)
//   - adherenceHistory: map (optional/nullable, size <= 365)
//   - lastCheckoffDate: string (optional/nullable, ISO 8601 string, <= 50 chars)
//   - equippedBadgeId: string (optional/nullable, <= 50 chars)
//   - phone: string (optional/nullable, <= 30 chars)
//   - bloodType: string (optional/nullable, <= 10 chars)
//   - age: int (optional/nullable, 0-150)
//   - weight: number (optional/nullable, 0-1000)
//   - height: number (optional/nullable, 0-300)
//   - email: string (optional/nullable, <= 100 chars)
//   - gender: string (optional/nullable, <= 30 chars)
//   - emergencyContact: string (optional/nullable, <= 100 chars)
//   - insuranceProvider: string (optional/nullable, <= 100 chars)
//   - primaryPhysician: string (optional/nullable, <= 100 chars)
//   - medicalConditions: list of strings (optional/nullable, size <= 50)
//   - allergies: list of strings (optional/nullable, size <= 50)
//
// Collection: /medicines/{medicineId}
// Document ID: medicineId
// Fields:
//   - id: string (required, 1-128 chars, immutable, matches document ID)
//   - userId: string (required, 1-128 chars, immutable, matches auth UID)
//   - name: string (required, 1-100 chars)
//   - dosage: string (required, 1-100 chars)
//   - intervalType: string (required, in ['daily', 'weekly', 'monthly', 'custom'])
//   - intervalCount: int (optional/nullable, 1-365)
//   - intervalUnit: string (optional/nullable, in ['days', 'weeks', 'months'])
//   - scheduleTimes: list of strings (required, size <= 24)
//   - mealContext: string (required, in ['beforeMeal', 'withMeal', 'afterMeal', 'none'])
//   - deliveryMethod: string (required, in ['water', 'milk', 'mixed', 'injection', 'drops', 'inhaler', 'tablet', 'capsule', 'syrup', 'other'])
//   - startDate: string (required, ISO 8601 string, 10-50 chars)
//   - endDate: string (optional/nullable, ISO 8601 string, <= 50 chars)
//   - durationDays: int (optional/nullable, 0-3650)
//   - isActive: bool (optional, boolean)
//   - initialQuantity: int (optional/nullable, 0-100000)
//   - remainingQuantity: int (optional/nullable, 0-100000)
//   - lowStockThreshold: int (optional/nullable, 0-10000)
//   - isPrn: bool (optional, boolean)
//   - minCooldownHours: int (optional/nullable, 0-168)
//   - createdAt: string (optional/nullable, ISO 8601 string, <= 50 chars)
//
// Collection: /adherence_logs/{logId}
// Document ID: logId
// Fields:
//   - id: string (required, 1-128 chars, immutable, matches document ID)
//   - medicineId: string (required, 1-128 chars, immutable)
//   - userId: string (required, 1-128 chars, immutable, matches auth UID)
//   - scheduledTime: string (required, ISO 8601 string, 10-50 chars)
//   - takenTime: string (optional/nullable, ISO 8601 string, <= 50 chars)
//   - status: string (required, in ['taken', 'skipped', 'missed'])
//   - mealNotes: string (optional/nullable, <= 500 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Core Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(data, allowedFields) {
      return data.keys().hasOnly(allowedFields);
    }

    function hasRequiredFields(data, requiredFields) {
      return data.keys().hasAll(requiredFields);
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalInt(data, field, minVal, maxVal) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is int && data[field] >= minVal && data[field] <= maxVal);
    }

    function isValidOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is list && data[field].size() <= maxSize);
    }

    function isValidOptionalMap(data, field, maxSize) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is map && data[field].size() <= maxSize);
    }

    // ===============================================================
    // Domain Validator Functions
    // ===============================================================

    function isValidUserProfile(data, userId) {
      return hasOnlyAllowedFields(data, [
               'uid', 'name', 'currentStreak', 'longestStreak', 'earnedBadges',
               'adherenceHistory', 'lastCheckoffDate', 'equippedBadgeId', 'phone',
               'bloodType', 'age', 'weight', 'height', 'email', 'gender',
               'emergencyContact', 'insuranceProvider', 'primaryPhysician',
               'medicalConditions', 'allergies'
             ]) &&
             hasRequiredFields(data, ['uid', 'name']) &&
             data.uid is string && data.uid == userId && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             isValidOptionalInt(data, 'currentStreak', 0, 100000) &&
             isValidOptionalInt(data, 'longestStreak', 0, 100000) &&
             isValidOptionalList(data, 'earnedBadges', 100) &&
             isValidOptionalMap(data, 'adherenceHistory', 365) &&
             isValidOptionalString(data, 'lastCheckoffDate', 50) &&
             isValidOptionalString(data, 'equippedBadgeId', 50) &&
             isValidOptionalString(data, 'phone', 30) &&
             isValidOptionalString(data, 'bloodType', 10) &&
             isValidOptionalInt(data, 'age', 0, 150) &&
             isValidOptionalNumber(data, 'weight', 0, 1000) &&
             isValidOptionalNumber(data, 'height', 0, 300) &&
             isValidOptionalString(data, 'email', 100) &&
             isValidOptionalString(data, 'gender', 30) &&
             isValidOptionalString(data, 'emergencyContact', 100) &&
             isValidOptionalString(data, 'insuranceProvider', 100) &&
             isValidOptionalString(data, 'primaryPhysician', 100) &&
             isValidOptionalList(data, 'medicalConditions', 50) &&
             isValidOptionalList(data, 'allergies', 50);
    }

    function isValidMedicine(data, medicineId) {
      return hasOnlyAllowedFields(data, [
               'id', 'userId', 'name', 'dosage', 'intervalType',
               'intervalCount', 'intervalUnit', 'scheduleTimes',
               'mealContext', 'deliveryMethod', 'startDate', 'endDate',
               'durationDays', 'isActive', 'initialQuantity',
               'remainingQuantity', 'lowStockThreshold', 'isPrn',
               'minCooldownHours', 'createdAt'
             ]) &&
             hasRequiredFields(data, [
               'id', 'userId', 'name', 'dosage', 'intervalType',
               'scheduleTimes', 'mealContext', 'deliveryMethod', 'startDate'
             ]) &&
             data.id is string && data.id == medicineId && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.dosage is string && data.dosage.size() > 0 && data.dosage.size() <= 100 &&
             data.intervalType is string && data.intervalType in ['daily', 'weekly', 'monthly', 'custom'] &&
             data.scheduleTimes is list && data.scheduleTimes.size() <= 24 &&
             data.mealContext is string && data.mealContext in ['beforeMeal', 'withMeal', 'afterMeal', 'none'] &&
             data.deliveryMethod is string && data.deliveryMethod in [
               'water', 'milk', 'mixed', 'injection', 'drops', 'inhaler',
               'tablet', 'capsule', 'syrup', 'other'
             ] &&
             data.startDate is string && data.startDate.size() >= 10 && data.startDate.size() <= 50 &&
             isValidOptionalInt(data, 'intervalCount', 1, 365) &&
             (!('intervalUnit' in data) || data.intervalUnit == null || (data.intervalUnit is string && data.intervalUnit in ['days', 'weeks', 'months'])) &&
             isValidOptionalString(data, 'endDate', 50) &&
             isValidOptionalInt(data, 'durationDays', 0, 3650) &&
             (!('isActive' in data) || data.isActive == null || data.isActive is bool) &&
             isValidOptionalInt(data, 'initialQuantity', 0, 100000) &&
             isValidOptionalInt(data, 'remainingQuantity', 0, 100000) &&
             isValidOptionalInt(data, 'lowStockThreshold', 0, 10000) &&
             (!('isPrn' in data) || data.isPrn == null || data.isPrn is bool) &&
             isValidOptionalInt(data, 'minCooldownHours', 0, 168) &&
             isValidOptionalString(data, 'createdAt', 50);
    }

    function isValidAdherenceLog(data, logId) {
      return hasOnlyAllowedFields(data, [
               'id', 'medicineId', 'userId', 'scheduledTime',
               'takenTime', 'status', 'mealNotes'
             ]) &&
             hasRequiredFields(data, [
               'id', 'medicineId', 'userId', 'scheduledTime', 'status'
             ]) &&
             data.id is string && data.id == logId && data.id.size() > 0 && data.id.size() <= 128 &&
             data.medicineId is string && data.medicineId.size() > 0 && data.medicineId.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.scheduledTime is string && data.scheduledTime.size() >= 10 && data.scheduledTime.size() <= 50 &&
             isValidOptionalString(data, 'takenTime', 50) &&
             data.status is string && data.status in ['taken', 'skipped', 'missed'] &&
             isValidOptionalString(data, 'mealNotes', 500);
    }

    // ===============================================================
    // Collection Security Rules
    // ===============================================================

    // User profile documents: strict owner-only access, blanket listing denied to protect PII
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
                       isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) &&
                       request.resource.data.uid == resource.data.uid &&
                       isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    // Medication documents: owner-only read, update, delete with immutable ownership
    match /medicines/{medicineId} {
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidMedicine(request.resource.data, medicineId);
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.id == resource.data.id &&
                       isValidMedicine(request.resource.data, medicineId);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Adherence logs: clinical history isolation with immutable ownership and medicine association
    match /adherence_logs/{logId} {
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidAdherenceLog(request.resource.data, logId);
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.medicineId == resource.data.medicineId &&
                       isValidAdherenceLog(request.resource.data, logId);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
